{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://pdfbuilder-2w8u.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/generate-pdf",
      "destination": "/api/generate-pdf"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
